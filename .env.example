# Copy to .env (never commit .env). Server-side API keys -> roles. Without a key every caller is a "customer".
BOT_API_KEYS={"change-me-agent-key": "agent", "change-me-admin-key": "admin", "change-me-kb-key": "kb_manager"}
BOT_HOST=127.0.0.1
BOT_PORT=8000
# Persist tickets / escalations / returning-customer sessions across restarts
BOT_STATE_FILE=data/runtime/state.json
# Optional LLM phrasing (output is always verified against the evidence)
# BOT_USE_LLM=1
# OPENAI_API_KEY=sk-...
# BOT_LLM_MODEL=gpt-4o-mini
